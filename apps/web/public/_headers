# Workers Static Assets가 정적 파일에 붙이는 헤더 (설계서 §14)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/sw.js
  Cache-Control: no-cache

# Vite가 내용 해시를 이름에 넣은 파일(JS, CSS, 글꼴)이라 오래 둬도 된다. 바뀌면 이름이 바뀐다
/assets/*
  Cache-Control: public, max-age=31536000, immutable
