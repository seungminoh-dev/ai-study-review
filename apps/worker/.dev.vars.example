# 로컬 개발용 값. `cp .dev.vars.example .dev.vars` 후 채운다. .dev.vars는 git에 올리지 않는다.
# TOKEN_PEPPER, BOOTSTRAP_CODE: `npm run gen:token`(레포 루트)으로 하나씩 만든다
# VAPID_*: `npm run gen:vapid`
APP_ORIGIN=http://localhost:8787
TOKEN_PEPPER=
BOOTSTRAP_CODE=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# GitHub 로그인을 로컬에서 시험할 때만. 콜백 주소가 http://localhost:8787/api/auth/github/callback인 OAuth 앱을 따로 만든다
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google 로그인을 로컬에서 시험할 때만. OAuth 클라이언트의 승인된 리디렉션 URI에 http://localhost:8787/api/auth/google/callback을 넣는다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
