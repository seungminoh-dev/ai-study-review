{
  "name": "@moai/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply moai --local",
    "db:migrate:remote": "wrangler d1 migrations apply moai --remote",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@moai/shared": "0.0.0",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261016.1",
    "@modelcontextprotocol/client": "2.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
