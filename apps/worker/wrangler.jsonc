{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // 서브도메인을 바꾸면 APP_ORIGIN과 VAPID_SUBJECT도 같이 바꾼다.
  "routes": [{ "pattern": "moai.smoh.dev", "custom_domain": true }],
  "assets": {
    // MVP 0은 정적 파일을 그대로 쓴다. MVP 1에서 Vite 빌드 결과(../web/dist)로 바꾼다.
    "directory": "../web/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moai",
      // `npx wrangler d1 create moai --location apac`가 알려 준 값
      "database_id": "cdbfd520-e11e-4723-a0d1-0cc6cb479594",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  // MVP 0에서만 호출 로그를 켜서 호출별 CPU 시간을 본다. 로그의 URL에 SPIKE_TOKEN이 남으므로
  // MVP 1에서 끄고(invocation_logs: false) SPIKE_TOKEN은 지운다 (설계서 §4.3).
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "vars": {
    // 위 routes와 같은 주소
    "APP_ORIGIN": "https://moai.smoh.dev",
    // `npm run gen:vapid`가 알려 준 공개 키. 연락처는 공개 레포라 메일 대신 https 주소를 쓴다 (RFC 8292)
    "VAPID_PUBLIC_KEY": "BDb6wmru8WN-GV7XKd4XyxOtNiy0C_WIOyW-kGF8-NXUKFJSaOG6_f7kEX9fqobg5nMy3JOZY22LdKSTPAQC_0Q",
    "VAPID_SUBJECT": "https://moai.smoh.dev"
  }
}
