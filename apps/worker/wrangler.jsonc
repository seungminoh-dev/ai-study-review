{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // 직접 바꿀 곳 1: 쓸 서브도메인 (docs/mvp0-runbook.md 1단계). APP_ORIGIN도 같이 바꾼다.
  "routes": [{ "pattern": "moai.example.com", "custom_domain": true }],
  "assets": {
    // MVP 0은 정적 파일을 그대로 쓴다. MVP 1에서 Vite 빌드 결과(../web/dist)로 바꾼다.
    "directory": "../web/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moai",
      // 직접 바꿀 곳 2: `npx wrangler d1 create moai --location apac`가 알려 준 값
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  // MVP 0에서만 호출 로그를 켜서 호출별 CPU 시간을 본다. 로그의 URL에 SPIKE_TOKEN이 남으므로
  // MVP 1에서 끄고(invocation_logs: false) SPIKE_TOKEN은 지운다 (설계서 §4.3).
  "observability": { "enabled": true, "logs": { "invocation_logs": true } },
  "vars": {
    // 직접 바꿀 곳 3: 위 routes와 같은 주소
    "APP_ORIGIN": "https://moai.example.com",
    // 직접 바꿀 곳 4: `npm run gen:vapid`가 알려 준 공개 키와 연락처
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "mailto:you@example.com"
  }
}
