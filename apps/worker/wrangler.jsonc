{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "moai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // 서브도메인을 바꾸면 APP_ORIGIN과 VAPID_SUBJECT도 같이 바꾼다.
  "routes": [{ "pattern": "moai.smoh.dev", "custom_domain": true }],
  "assets": {
    // PWA 빌드 결과. 배포 전에 `npm run build`(레포 루트)로 만든다
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moai",
      // `npx wrangler d1 create moai --location apac`가 알려 준 값
      "database_id": "cdbfd520-e11e-4723-a0d1-0cc6cb479594",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  // 호출 로그는 요청 URL을 남기는데, MCP URL에는 비밀 토큰이 들어 있어서 끈다 (설계서 §4.3). 직접 남기는 로그만 쓴다.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Workers Paid의 기본 CPU 한도는 요청당 30초다. 코드가 잘못 돌아 CPU를 오래 쓰는 일을 막으려고 1초로 낮춘다.
  // 지금까지 잰 최대값은 84ms다 (설계서 §2.1 실측 기록).
  "limits": { "cpu_ms": 1000 },
  "vars": {
    // 위 routes와 같은 주소
    "APP_ORIGIN": "https://moai.smoh.dev",
    // `npm run gen:vapid`가 알려 준 공개 키. 연락처는 공개 레포라 메일 대신 https 주소를 쓴다 (RFC 8292)
    "VAPID_PUBLIC_KEY": "BDb6wmru8WN-GV7XKd4XyxOtNiy0C_WIOyW-kGF8-NXUKFJSaOG6_f7kEX9fqobg5nMy3JOZY22LdKSTPAQC_0Q",
    "VAPID_SUBJECT": "https://moai.smoh.dev"
  }
}
